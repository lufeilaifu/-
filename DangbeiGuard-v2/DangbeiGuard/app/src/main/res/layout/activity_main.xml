<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#1A1A1A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="当贝桌面守护"
        android:textSize="28sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hint_not_enabled"
        android:textSize="16sp"
        android:textColor="#FFFF5722"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_open_accessibility"
        android:textSize="16sp"
        android:padding="16dp 32dp"
        android:background="#FF6F00"
        android:textColor="#FFFFFF"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <Button
        android:id="@+id/btn_add_blocked"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="自定义拦截包名（高级）"
        android:textSize="14sp"
        android:padding="12dp 24dp"
        android:layout_marginTop="16dp"
        android:background="#333333"
        android:textColor="#AAAAAA"
        android:focusable="true"
        android:focusableInTouchMode="true" />

</LinearLayout>
